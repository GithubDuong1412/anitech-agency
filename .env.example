# Copy to .env.local and fill in. Never commit .env.local.
# Without LLM_API_KEY the app runs in demo mode (scripted agent replies, still saved to the database).

# Any OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to "false" if your provider rejects response_format.
LLM_JSON_MODE=true
# Max tokens per agent turn.
LLM_MAX_TOKENS=700

# Where the per-map SQLite files live (default: ./data).
# DATA_DIR=
