# Copy to .env.local and fill in. Never commit .env.local.
# Without LLM_API_KEY the app runs in demo mode (scripted agent replies, still saved to the database).

# Any OpenAI-compatible chat completions endpoint.
# LM Studio on this machine: LLM_API_KEY=lm-studio, LLM_BASE_URL=http://127.0.0.1:1234/v1, LLM_MODEL=qwen2.5-coder-14b, LLM_JSON_MODE=false, LLM_DEPARTMENTS=it
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to "false" if your provider rejects response_format.
LLM_JSON_MODE=true
# Max tokens per agent turn.
LLM_MAX_TOKENS=700
# Comma-separated department ids that may call the model. Empty means every map.
# LLM_DEPARTMENTS=it
# Per-request timeout and total model calls per task (bounded to 120s and 16 turns).
LLM_TIMEOUT_MS=45000
LLM_MAX_TURNS=8

# MySQL in Laragon (one database for every map). Leave DB_HOST empty to use the SQLite fallback in ./data.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anitech_agency

# Only used when DB_HOST is empty.
# DATA_DIR=
